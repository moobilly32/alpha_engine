# ---------------------------------------------------------------------------
# alpha_engine execution — environment
# Copy to `.env` in this directory, fill in, then lock it down:
#     cp .env.template .env && chmod 600 .env
# `.env` is git-ignored. Never commit real keys or a brokerage password.
# ---------------------------------------------------------------------------

# Which broker the execution engine drives. One of:
#   alpaca_paper    -> alpaca_client.AlpacaBroker   (paper trading)
#   robinhood_live  -> robinhood_client.RobinhoodBroker  (LIVE money)
BROKER_MODE=alpaca_paper


# --- Alpaca (paper) --------------------------------------------------------
# Keys from https://app.alpaca.markets/  (Paper Trading -> API Keys).
# BASE_URL is the source of truth for paper-vs-live; the client derives the
# alpaca-py `paper` flag from it.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# live endpoint (do not use unless you mean it): https://api.alpaca.markets


# --- Robinhood (live trading) -------------------------------------------------
# SECURITY: this is a live brokerage password in plaintext. Keep the file at
# chmod 600, out of git, and off any synced/backed-up location you don't
# control. robin_stocks caches a session token under ~/.tokens/ after the
# first successful login, so these are read at most once per token lifetime.
RH_EMAIL=
RH_PASSWORD=

# MFA is mandatory on Robinhood. For unattended login provide the TOTP seed
# (the long base32 string shown when you add an authenticator app to the
# account). Requires `pip install pyotp`.
RH_MFA_SECRET=
# One-shot alternative for a manual run only — a single current 6-digit code.
# Expires in ~30s; leave blank for automation.
RH_MFA_CODE=

# Which brokerage account to trade, when the login has more than one (e.g.
# individual + IRA). Find it in the Robinhood app under Account -> Settings,
# or via robin_stocks' load_account_profile(). Every order the engine places
# is pinned to this account. Leave blank ONLY if the login has exactly one
# account — otherwise robin_stocks falls back to its own default, which may
# not be the account you mean to trade.
RH_ACCOUNT_NUMBER=
